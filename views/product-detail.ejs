<%- include('partials/header') %>

<section class="product-detail" data-testid="product-detail">
  <div class="product-detail-emoji"><%= product.image_emoji %></div>
  <div class="product-detail-info">
    <h1 data-testid="pd-name"><%= product.name %></h1>
    <p class="product-category"><%= product.category %></p>
    <p class="product-price" data-testid="pd-price">$<%= product.price.toFixed(2) %></p>
    <p><%= product.description %></p>
    <p class="product-stock <%= product.stock === 0 ? 'out-of-stock' : '' %>" data-testid="pd-stock">
      <% if (product.stock === 0) { %>Out of stock<% } else { %><%= product.stock %> in stock<% } %>
    </p>
    <form action="/cart/add" method="POST" class="inline-form">
      <input type="hidden" name="product_id" value="<%= product.id %>" />
      <label for="qty">Quantity</label>
      <input type="number" id="qty" name="quantity" value="1" min="1" data-testid="pd-quantity" />
      <button type="submit" class="btn btn-primary" data-testid="pd-add-to-cart" <%= product.stock === 0 ? 'disabled' : '' %>>
        Add to Cart
      </button>
    </form>
    <a href="/products" class="btn btn-link">&larr; Back to products</a>
  </div>
</section>

<%- include('partials/footer') %>
