<%- include('../partials/header') %>

<section class="admin-page">
  <h1>Admin Dashboard</h1>
  <div class="stat-grid">
    <div class="stat-card"><span class="stat-number" data-testid="stat-products"><%= productCount %></span><span>Products</span></div>
    <div class="stat-card"><span class="stat-number" data-testid="stat-users"><%= userCount %></span><span>Users</span></div>
    <div class="stat-card"><span class="stat-number" data-testid="stat-orders"><%= orderCount %></span><span>Orders</span></div>
  </div>
  <div class="admin-links">
    <a href="/admin/products" class="btn btn-secondary" data-testid="admin-manage-products">Manage Products</a>
    <a href="/admin/users" class="btn btn-secondary" data-testid="admin-manage-users">Manage Users</a>
  </div>
</section>

<%- include('../partials/footer') %>
