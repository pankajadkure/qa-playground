<%- include('../partials/header') %>

<section class="admin-page">
  <h1>Manage Products</h1>
  <% if (deleteError) { %>
    <div class="alert alert-error" data-testid="delete-product-error">
      Can't delete that product - it appears in an existing order.
    </div>
  <% } %>
  <button class="btn btn-primary" id="open-add-modal" data-testid="open-add-product-modal">+ Add Product</button>

  <table class="data-table" data-testid="admin-products-table">
    <thead>
      <tr><th>ID</th><th>SKU</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr>
    </thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr data-testid="admin-product-row" data-id="<%= p.id %>">
          <td><%= p.id %></td>
          <td><%= p.sku %></td>
          <td><%= p.name %></td>
          <td><%= p.category %></td>
          <td><%= p.price.toFixed(2) %></td>
          <td><%= p.stock %></td>
          <td>
            <button
              class="btn btn-secondary btn-sm edit-product-btn"
              data-testid="edit-product-btn"
              data-id="<%= p.id %>"
              data-sku="<%= p.sku %>"
              data-name="<%= p.name %>"
              data-category="<%= p.category %>"
              data-price="<%= p.price %>"
              data-stock="<%= p.stock %>"
              data-description="<%= p.description %>"
              data-emoji="<%= p.image_emoji %>"
            >Edit</button>
            <button
              class="btn btn-danger btn-sm delete-product-btn"
              data-testid="delete-product-btn"
              data-id="<%= p.id %>"
              data-name="<%= p.name %>"
            >Delete</button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>

<!-- Add/Edit Product Modal -->
<div class="modal-overlay" id="product-modal-overlay" data-testid="product-modal-overlay" hidden>
  <div class="modal" data-testid="product-modal">
    <h2 id="product-modal-title">Add Product</h2>
    <form id="product-form" action="/admin/products" method="POST" data-testid="product-form">
      <div class="form-group">
        <label>SKU</label>
        <input type="text" name="sku" id="pf-sku" required data-testid="pf-sku" />
      </div>
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" id="pf-name" required data-testid="pf-name" />
      </div>
      <div class="form-group">
        <label>Category</label>
        <input type="text" name="category" id="pf-category" required data-testid="pf-category" />
      </div>
      <div class="form-group">
        <label>Price</label>
        <input type="number" step="0.01" name="price" id="pf-price" required data-testid="pf-price" />
      </div>
      <div class="form-group">
        <label>Stock</label>
        <input type="number" name="stock" id="pf-stock" required data-testid="pf-stock" />
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="description" id="pf-description" data-testid="pf-description"></textarea>
      </div>
      <div class="form-group">
        <label>Emoji</label>
        <input type="text" name="image_emoji" id="pf-emoji" data-testid="pf-emoji" />
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-link" id="cancel-product-modal" data-testid="cancel-product-modal">Cancel</button>
        <button type="submit" class="btn btn-primary" data-testid="save-product-btn">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="delete-modal-overlay" data-testid="delete-modal-overlay" hidden>
  <div class="modal">
    <h2>Delete Product</h2>
    <p>Are you sure you want to delete "<span id="delete-product-name" data-testid="delete-product-name"></span>"?</p>
    <form id="delete-form" method="POST" data-testid="delete-form">
      <div class="modal-actions">
        <button type="button" class="btn btn-link" id="cancel-delete-modal" data-testid="cancel-delete-modal">Cancel</button>
        <button type="submit" class="btn btn-danger" data-testid="confirm-delete-btn">Delete</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/admin-products.js"></script>
<%- include('../partials/footer') %>
