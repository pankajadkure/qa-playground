<%- include('partials/header') %>

<section class="auth-form-section">
  <h1>Contact Us</h1>
  <% if (submitted) { %>
    <div class="alert alert-success" data-testid="contact-success">Thanks! Your message has been received.</div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error" data-testid="contact-error"><%= error %></div>
  <% } %>
  <form action="/contact" method="POST" class="form" id="contact-form" data-testid="contact-form" novalidate>
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required value="<%= values.name || '' %>" data-testid="contact-name" />
    </div>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required value="<%= values.email || '' %>" data-testid="contact-email" />
      <span class="field-hint">Note: plus-addressed emails like user+test@example.com are rejected by validation. See BUGS.md UI-4.</span>
    </div>
    <div class="form-group">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required data-testid="contact-message"><%= values.message || '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary" data-testid="contact-submit">Send Message</button>
  </form>
</section>

<%- include('partials/footer') %>
